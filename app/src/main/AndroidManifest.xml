<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ar.bydlauncher">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />
    <uses-permission android:name="android.permission.INJECT_EVENTS" />

    <application
        android:name=".App"
        android:label="BYD Launcher"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.BYDLauncher">

        <!-- ═══ Главный лаунчер ═══ -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density|smallestScreenSize|screenLayout"
            android:screenOrientation="sensorLandscape">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter android:priority="10">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- ═══ SOH-детали ═══ -->
        <activity
            android:name=".BatteryDetailsActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.BYDLauncher.Fullscreen" />

        <!-- ═══ История поездок ═══ -->
        <activity
            android:name=".TripsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:stateNotNeeded="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.BYDLauncher.Fullscreen" />

        <!-- ═══ Карта поездки ═══ -->
        <activity
            android:name=".TripMapActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.BYDLauncher.Fullscreen" />

        <!-- ═══ Детали погоды ═══ -->
        <activity
            android:name=".WeatherDetailsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.BYDLauncher.Fullscreen" />

        <!-- ═══ История зарядок ═══ -->
        <activity
            android:name=".ChargingHistoryActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.BYDLauncher.Fullscreen" />

        <!-- ═══ Настройки лаунчера ═══ -->
        <activity
            android:name=".LauncherSettingsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.BYDLauncher.Fullscreen" />

        <!-- ═══ Комфорт ═══ -->
        <activity
            android:name=".ComfortActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.BYDLauncher.Fullscreen" />

        <!-- ═══ Tech: тестер FID ═══ -->
        <activity
            android:name=".TechActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.BYDLauncher.Fullscreen" />

        <!-- ═══ Anchor-service ═══ -->
        <service
            android:name=".service.BydBackgroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the BYD launcher process alive while the user is in the navigator or other BYD apps, so the BMS polling loop, trip recording, and GPS keep running." />
        </service>

        <!-- Диагностика кнопок руля: пока только логирование, нажатия не блокируются. -->
        <service
            android:name=".service.SteeringWheelAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:enabled="true"
            android:exported="true"
            android:label="BYD Launcher — кнопки руля">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/steering_wheel_accessibility_service" />
        </service>

        <!-- ═══ Boot receiver ═══ -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.REBOOT" />
            </intent-filter>
        </receiver>

    </application>

</manifest>