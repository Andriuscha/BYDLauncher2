<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ═══ СТРОКА ДНЯ ═══ -->
    <LinearLayout
        android:id="@+id/dayRow"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <!-- ─── КОЛОНКА 1: ДЕНЬ (20%) ─── -->
        <TextView
            android:id="@+id/dayName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="20"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:singleLine="true"
            android:text="—"
            android:textAllCaps="true"
            android:textColor="#B0B4BD"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- ─── КОЛОНКА 2: ИКОНКА + ОПИСАНИЕ (28%) ─── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="28"
            android:gravity="center_vertical|start"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dayIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@android:color/transparent" />

            <TextView
                android:id="@+id/dayCond"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:letterSpacing="0.04"
                android:singleLine="true"
                android:text="—"
                android:textAllCaps="true"
                android:textColor="#B0B4BD"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ─── КОЛОНКА 3: ОСАДКИ + ВЕТЕР (22%) ─── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="22"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <!-- Иконка капли -->
            <ImageView
                android:id="@+id/dayPrecipIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <!-- Значение осадков -->
            <TextView
                android:id="@+id/dayPrecip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:text=""
                android:textColor="#7CB7FF"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Ветер -->
            <TextView
                android:id="@+id/dayWind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.02"
                android:singleLine="true"
                android:text="—"
                android:textColor="#7CB7FF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ─── КОЛОНКА 4: MAX (15%) ─── -->
        <TextView
            android:id="@+id/dayMax"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="15"
            android:fontFamily="monospace"
            android:gravity="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="—°"
            android:textColor="#FF9F43"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- ─── КОЛОНКА 5: MIN (15%) ─── -->
        <TextView
            android:id="@+id/dayMin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="15"
            android:fontFamily="monospace"
            android:gravity="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="—°"
            android:textColor="#22D3EE"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ─── РАЗДЕЛИТЕЛЬ ─── -->
    <View
        android:id="@+id/dayDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#3A3E48" />

</LinearLayout>