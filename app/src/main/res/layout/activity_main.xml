<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/launcher_background"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="70px"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- ЛЕВАЯ КОЛОНКА: погода + BMS                                  -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="45"
                android:background="@drawable/bg_frosted_card"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- WEATHER CARD (кликабельная — открывает расширенный прогноз) -->
                <LinearLayout
                    android:id="@+id/weatherCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:clickable="true"
                    android:focusable="true">

                    <!-- ── ЛОКАЦИЯ ── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_marginEnd="5dp"
                            android:src="@drawable/ic_pin"
                            app:tint="@color/c_teal"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/wLocName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.08"
                            android:singleLine="true"
                            android:text="Определение…"
                            android:textAllCaps="true"
                            android:textColor="#B0B4BD"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- ── ОСНОВНОЙ РЯД: темп | день/ночь | УЛИЦА/САЛОН ── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- ═══ КОЛОНКА 1: ИКОНКА + ТЕМПЕРАТУРА + ОПИСАНИЕ ═══ -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_weight="35"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/wIcon"
                                    android:layout_width="70dp"
                                    android:layout_height="65dp"
                                    android:layout_marginEnd="14dp"
                                    android:contentDescription="@null"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_weather_placeholder" />

                                <TextView
                                    android:id="@+id/wTemp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:includeFontPadding="false"
                                    android:letterSpacing="-0.05"
                                    android:text="--°"
                                    android:textColor="#FFFFFF"
                                    android:textSize="53sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Описание — под температурой, по центру колонки 1 -->
                            <TextView
                                android:id="@+id/wCond"
                                android:layout_width="207dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="1dp"
                                android:ellipsize="end"
                                android:fontFamily="monospace"
                                android:gravity="center"
                                android:letterSpacing="0.08"
                                android:singleLine="true"
                                android:text="--"
                                android:textAllCaps="true"
                                android:textColor="#A5C8FF"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Divider 1 -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="10dp"
                            android:background="#505561" />

                        <!-- ═══ КОЛОНКА 2: ДЕНЬ/НОЧЬ + ВЕТЕР/ОСАДКИ ═══ -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="90dp"
                            android:layout_gravity="center_vertical"
                            android:layout_weight="25"
                            android:gravity="start"
                            android:orientation="vertical">

                            <!-- Строка 1: ДНЁМ 20° -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical|start"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="65dp"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:gravity="start"
                                    android:letterSpacing="0.06"
                                    android:singleLine="true"
                                    android:text="ДНЁМ"
                                    android:textAllCaps="true"
                                    android:textColor="#B0B4BD"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/wDay"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:includeFontPadding="false"
                                    android:singleLine="true"
                                    android:text="--°"
                                    android:textColor="#FFFFFF"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Строка 2: НОЧЬЮ 12° -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:gravity="center_vertical|start"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="65dp"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:gravity="start"
                                    android:letterSpacing="0.06"
                                    android:singleLine="true"
                                    android:text="НОЧЬЮ"
                                    android:textAllCaps="true"
                                    android:textColor="#B0B4BD"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/wNight"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:includeFontPadding="false"
                                    android:singleLine="true"
                                    android:text="--°"
                                    android:textColor="#FFFFFF"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Доп. инфо: ветер / осадки -->
                            <TextView
                                android:id="@+id/wExtra"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="monospace"
                                android:gravity="start"
                                android:letterSpacing="0.01"
                                android:singleLine="true"
                                android:text="-------"
                                android:textColor="#7CB7FF"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Divider 2 -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="10dp"
                            android:background="#505561" />

                        <!-- ═══ КОЛОНКА 3: УЛИЦА / САЛОН ═══ -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="90dp"
                            android:layout_gravity="center_vertical"
                            android:layout_weight="25"
                            android:gravity="start"
                            android:orientation="vertical">

                            <!-- Подписи (как ДНЁМ/НОЧЬЮ) -->
                            <LinearLayout
                                android:layout_width="200dp"
                                android:layout_height="15dp"
                                android:gravity="center_vertical|start"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="80dp"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:gravity="start"
                                    android:letterSpacing="0.08"
                                    android:singleLine="true"
                                    android:text=" УЛИЦА"
                                    android:textAllCaps="true"
                                    android:textColor="#B0B4BD"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="76dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="monospace"
                                    android:gravity="start"
                                    android:letterSpacing="0.08"
                                    android:singleLine="true"
                                    android:text="САЛОН"
                                    android:textAllCaps="true"
                                    android:textColor="#B0B4BD"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Значения (крупнее, чем 16sp) -->
                            <LinearLayout
                                android:layout_width="175dp"
                                android:layout_height="55dp"
                                android:layout_marginTop="1dp"
                                android:gravity="start"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/wOut"
                                    android:layout_width="80dp"
                                    android:layout_height="65dp"
                                    android:fontFamily="monospace"
                                    android:gravity="start"
                                    android:includeFontPadding="false"
                                    android:text="--°"
                                    android:textColor="#22D3EE"
                                    android:textSize="39sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/wIn"
                                    android:layout_width="80dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginStart="3dp"
                                    android:fontFamily="monospace"
                                    android:gravity="start"
                                    android:includeFontPadding="false"
                                    android:text="--°"
                                    android:textColor="#FFC107"
                                    android:textSize="39sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="6dp"
                    android:background="#40FFFFFF" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="none"
                    android:fillViewport="true">

                    <include layout="@layout/bms_dashboard" />

                </ScrollView>

            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- ПРАВАЯ КОЛОНКА: freeform-окно Яндекса                        -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <FrameLayout
                android:id="@+id/navContainer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="55"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/navPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Навигатор&#10;загружается…"
                    android:textColor="#AAAAAA"
                    android:textSize="16sp"
                    android:textAlignment="center"
                    android:background="@drawable/bg_frosted_card" />

            </FrameLayout>

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- НИЖНИЙ БАР                                                    -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="45"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- 1. Навигация (НЕ меняется) -->
                <LinearLayout
                    android:id="@+id/btnNav"
                    style="@style/DockButton"
                    android:background="@drawable/btn_dock_nav">

                    <ImageView
                        style="@style/DockIcon"
                        android:src="@drawable/ic_nav"
                        app:tint="@color/dock_icon_nav"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/labelNav"
                        style="@style/DockLabel"
                        android:text="Навигация" />
                </LinearLayout>

                <!-- 2. Настройки → LauncherSettingsActivity -->
                <LinearLayout
                    android:id="@+id/btnCar"
                    style="@style/DockButton"
                    android:background="@drawable/btn_dock_set">

                    <ImageView
                        style="@style/DockIcon"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/dock_icon_set"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/labelCar"
                        style="@style/DockLabel"
                        android:text="Настройки" />
                </LinearLayout>

                <!-- 3. Комфорт → ComfortActivity -->
                <LinearLayout
                    android:id="@+id/btnClimate"
                    style="@style/DockButton"
                    android:background="@drawable/btn_dock_clim">

                    <ImageView
                        style="@style/DockIcon"
                        android:src="@drawable/ic_climate"
                        app:tint="@color/dock_icon_clim"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/labelClimate"
                        style="@style/DockLabel"
                        android:text="Комфорт" />
                </LinearLayout>

                <!-- 4. Tech → TechActivity -->
                <LinearLayout
                    android:id="@+id/btnTrip"
                    style="@style/DockButton"
                    android:background="@drawable/btn_dock_trip">

                    <ImageView
                        style="@style/DockIcon"
                        android:src="@drawable/ic_trip"
                        app:tint="@color/dock_icon_trip"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/labelTrip"
                        style="@style/DockLabel"
                        android:text="Tech" />
                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="55" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>