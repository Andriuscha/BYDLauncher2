<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/launcher_background"
        android:contentDescription="@null" />

    <!-- Верхний отступ 60px — под оверлей-плашку с поездкой -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60px"
        android:orientation="vertical">

        <!-- Split: слева погода + BMS, справа навигатор -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- ============================================================ -->
            <!-- ЛЕВАЯ КОЛОНКА: погода + BMS                                  -->
            <!-- ============================================================ -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="45"
                android:background="@drawable/bg_frosted_card"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- ============ WEATHER CARD ============ -->
                <LinearLayout
                    android:id="@+id/weatherCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="10dp">

                    <!-- ИКОНКА -->
                    <ImageView
                        android:id="@+id/wIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_weather_placeholder" />

                    <!-- ЦЕНТР -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Локация -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_marginEnd="4dp"
                                android:src="@drawable/ic_pin"
                                app:tint="@color/c_teal"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/wLocName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:fontFamily="monospace"
                                android:letterSpacing="0.08"
                                android:textAllCaps="true"
                                android:textSize="10sp"
                                android:textColor="@color/t3"
                                android:text="Определение…" />
                        </LinearLayout>

                        <!-- Температура + условие -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="bottom"
                            android:layout_marginTop="2dp">

                            <TextView
                                android:id="@+id/wTemp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:includeFontPadding="false"
                                android:letterSpacing="-0.04"
                                android:textSize="38sp"
                                android:textStyle="bold"
                                android:textColor="@color/t1"
                                android:text="--°" />

                            <TextView
                                android:id="@+id/wCond"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_marginBottom="6dp"
                                android:fontFamily="monospace"
                                android:letterSpacing="0.12"
                                android:textAllCaps="true"
                                android:textSize="11sp"
                                android:textColor="@color/t2"
                                android:text="--" />
                        </LinearLayout>

                        <!-- Днём / Ночью -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="2dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:letterSpacing="0.10"
                                android:textAllCaps="true"
                                android:textSize="9sp"
                                android:textColor="@color/t3"
                                android:text="Днём " />

                            <TextView
                                android:id="@+id/wDay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textStyle="bold"
                                android:textSize="11sp"
                                android:textColor="@color/c_amber"
                                android:text="--°" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="6dp"
                                android:fontFamily="monospace"
                                android:textSize="10sp"
                                android:textColor="@color/t3"
                                android:text="/" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:letterSpacing="0.10"
                                android:textAllCaps="true"
                                android:textSize="9sp"
                                android:textColor="@color/t3"
                                android:text="Ночью " />

                            <TextView
                                android:id="@+id/wNight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textStyle="bold"
                                android:textSize="11sp"
                                android:textColor="@color/c_violet"
                                android:text="--°" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ЧИПЫ: Улица / Салон -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginStart="10dp">

                        <!-- Улица -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_temp_chip_out"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:layout_marginEnd="6dp"
                            android:minWidth="64dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:letterSpacing="0.10"
                                android:textAllCaps="true"
                                android:textSize="8sp"
                                android:textColor="@color/t3"
                                android:text="Улица" />

                            <TextView
                                android:id="@+id/wOut"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:textColor="@color/c_teal"
                                android:text="--°" />
                        </LinearLayout>

                        <!-- Салон -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_temp_chip_in"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:minWidth="64dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:letterSpacing="0.10"
                                android:textAllCaps="true"
                                android:textSize="8sp"
                                android:textColor="@color/t3"
                                android:text="Салон" />

                            <TextView
                                android:id="@+id/wIn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:textColor="@color/c_amber"
                                android:text="--°" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

                <!-- разделитель под виджетом -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="10dp"
                    android:background="#40FFFFFF" />

                <!-- ============ BMS: текстовый вывод ============ -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/contentText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Загрузка…"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"
                        android:fontFamily="monospace" />

                </ScrollView>

            </LinearLayout>

            <!-- ============================================================ -->
            <!-- ПРАВАЯ КОЛОНКА: сюда прилетит Яндекс                          -->
            <!-- ============================================================ -->
            <FrameLayout
                android:id="@+id/navContainer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="55"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/navPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Навигатор&#10;загружается…"
                    android:textColor="#AAAAAA"
                    android:textSize="16sp"
                    android:textAlignment="center"
                    android:background="@drawable/bg_frosted_card" />

            </FrameLayout>

        </LinearLayout>

        <!-- ============================================================ -->
        <!-- НИЖНИЙ БАР: 4 кнопки в стиле hi-tech glass dock (45% ширины) -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="45"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- 1. Навигация -->
                <LinearLayout
                    android:id="@+id/btnNav"
                    style="@style/DockButton"
                    android:background="@drawable/btn_dock_nav">

                    <ImageView
                        style="@style/DockIcon"
                        android:src="@drawable/ic_nav"
                        app:tint="@color/dock_icon_nav"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/labelNav"
                        style="@style/DockLabel"
                        android:text="Навигация" />
                </LinearLayout>

                <!-- 2. Настройки -->
                <LinearLayout
                    android:id="@+id/btnCar"
                    style="@style/DockButton"
                    android:background="@drawable/btn_dock_set">

                    <ImageView
                        style="@style/DockIcon"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/dock_icon_set"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/labelCar"
                        style="@style/DockLabel"
                        android:text="Настройки" />
                </LinearLayout>

                <!-- 3. Климат -->
                <LinearLayout
                    android:id="@+id/btnClimate"
                    style="@style/DockButton"
                    android:background="@drawable/btn_dock_clim">

                    <ImageView
                        style="@style/DockIcon"
                        android:src="@drawable/ic_climate"
                        app:tint="@color/dock_icon_clim"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/labelClimate"
                        style="@style/DockLabel"
                        android:text="Климат" />
                </LinearLayout>

                <!-- 4. Поездки -->
                <LinearLayout
                    android:id="@+id/btnTrip"
                    style="@style/DockButton"
                    android:background="@drawable/btn_dock_trip">

                    <ImageView
                        style="@style/DockIcon"
                        android:src="@drawable/ic_trip"
                        app:tint="@color/dock_icon_trip"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/labelTrip"
                        style="@style/DockLabel"
                        android:text="Поездки" />
                </LinearLayout>

            </LinearLayout>

            <!-- Правая половина — там freeform-окно Яндекса, бар не нужен -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="55" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>