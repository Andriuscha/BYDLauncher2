<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Градиент сверху вниз создаёт эффект матового стекла -->
    <gradient
        android:angle="270"
        android:startColor="#B3222C3A"
        android:centerColor="#B3182230"
        android:endColor="#B30D1520" />

    <!-- Скруглённые углы -->
    <corners android:radius="20dp" />

    <!-- Тонкая светлая окантовка для эффекта "стеклянной грани" -->
    <stroke
        android:width="1dp"
        android:color="#40FFFFFF" />

</shape>